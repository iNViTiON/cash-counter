{
	"name": "cash-count",
	"description": "EuroCash — offline-first euro cash counting PWA",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:sigv4": "bun scripts/sigv4-check.ts",
		"icons": "bash scripts/make-icons.sh",
		"fonts": "python3 scripts/fetch-fonts.py",
		"deploy": "wrangler pages deploy build",
		"serve:build": "bun scripts/serve-build.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	}
}

# Cloudflare Pages headers.
# Hashed bundles are immutable; the shell and the service worker must not be.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# These two do not take effect, and the cause is NOT this file — do not spend
# time rewriting them again. Measured on the deployed site:
#
#   path                         cf-cache-status   served max-age
#   /sw.js                       EXPIRED           14400   <- ours ignored
#   /workbox-*.js                REVALIDATED       14400   <- ours ignored
#   /_app/immutable/*            HIT               31536000
#   /fonts/*                     HIT               31536000
#   /manifest.webmanifest        DYNAMIC           no-cache (ours, honoured)
#   /robots.txt                  REVALIDATED       14400   (no rule at all)
#
# Everything edge-cached with a *short* origin TTL comes back as 14400; anything
# DYNAMIC keeps our header, and long TTLs survive. That is the zone's Browser
# Cache TTL (4h) raising short values, so the lever is Cloudflare's dashboard —
# Caching > Configuration > Browser Cache TTL > "Respect Existing Headers" —
# not `_headers`. The `public` and `must-revalidate` below DO come through,
# which is what pinned the cause to max-age alone.
#
# Left as-is because it is cosmetic: `updateViaCache` defaults to `imports`, so
# browsers already bypass the HTTP cache for sw.js itself, and workbox-*.js is
# content-hashed, so caching it for 4h is correct rather than merely harmless.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY

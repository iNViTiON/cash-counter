# Cloudflare Pages headers.
# Hashed bundles are immutable; the shell and the service worker must not be.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# A bare `no-cache` here is silently ignored by the edge — every non-.js rule in
# this file applies, both root-level .js rules did not. Spelled out as an
# explicit max-age instead, which is the form Pages already serves on `/`.
# If these still come back as `max-age=14400`, the override is a zone-level
# Cache Rule rather than anything in this file.
#
# Either way it is cosmetic: `updateViaCache` defaults to `imports`, so browsers
# bypass the HTTP cache for sw.js itself, and workbox-*.js is content-hashed.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
